# Garmin 資料抓取所需的設定範本
#
# 用法：把這個檔案複製成同目錄下的 .env，再填入你自己的值。
#
#     cp garmin/.env.example garmin/.env      # macOS / Linux
#     copy garmin\.env.example garmin\.env    # Windows
#
# ⚠️ .env 內含真實帳號密碼，已被 .gitignore 擋住，絕對不要提交。
#    這份 .example 只有 key 名稱、值一律留空，可以安全進版控。
#
# 讀取方式：garmin/garmin_connect_fetch.py 的 _load_env_file() 會在啟動時
# 把這裡的 KEY=VALUE 讀進環境變數。格式就是一行一個，不要加引號。
# 若環境變數已經存在，.env 不會覆蓋它——所以 CI 或臨時測試可以直接設環境變數蓋過。

# Garmin Connect 登入用的 email
GARMIN_EMAIL=

# Garmin Connect 登入密碼
GARMIN_PASSWORD=
