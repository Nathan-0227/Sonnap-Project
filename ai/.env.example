# AI 睡眠顧問所需的設定範本
#
# 用法：複製成同目錄下的 .env 再填值。
#
#     cp ai/.env.example ai/.env       # macOS / Linux
#     copy ai\.env.example ai\.env     # Windows
#
# ⚠️ .env 已被 .gitignore 擋住，絕對不要提交。這份 .example 值一律留空，可安全進版控。

# Anthropic API 金鑰（必填）。到 https://console.anthropic.com/ 取得。
# 沒有這個 key 時 generate_advice.py 會印出提示並正常結束（exit 0），
# 既有內容不會被動到，pipeline 也不會中斷。
ANTHROPIC_API_KEY=

# 選填：要用哪個模型。留空則使用程式預設的 claude-opus-5。
# 放在設定裡而不是寫死在程式碼，是為了讓「模型改名」變成改設定而不是改程式。
ANTHROPIC_MODEL=

# ⚠️ 尚未實作：目前輸出**固定是臺灣正體中文**（prompt 本身就是中文寫的，
#    改這個變數不會讓輸出變成別的語言）。留著只是佔位，之後要做多語系時
#    要連 SYSTEM_PROMPT / FEW_SHOT / FORMAT_RULES 一起處理。
ADVICE_LANG=
