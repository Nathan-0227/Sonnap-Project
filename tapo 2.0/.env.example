# tapo 2.0 設定範本
#
# 用法：複製成同目錄的 .env，填入自己的值。
#   cp "tapo 2.0/.env.example" "tapo 2.0/.env"
#
# ⚠️ .env 本身**永遠不要進版控**（.gitignore 第 8 行已經擋掉）。
#    但從 GitHub 網頁「Add files via upload」上傳會**繞過本機 .gitignore**，
#    這正是它曾經被誤傳上去的原因——請一律用 git commit，不要用網頁上傳。

# Camera Settings
# RTSP 網址內含攝影機帳密，格式：rtsp://<帳號>:<密碼>@<IP>:554/stream1
CAMERA_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.x.x:554/stream1

# Database Settings
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=sonnap

# Time Settings
#
# SLEEP_START 決定攝影機幾點開始錄。它不只是「省硬碟」的設定——
# 人已經睡著之後才開機的夜晚，上床時刻在結構上就錄不到，演算法再好也救不回來。
#
# 用 57 個有入睡時刻的 Garmin 夜晚實測（SLEEP_END 固定 08:00）：
#
#     SLEEP_START   涵蓋到入睡   錄不到      代價
#     01:00            50        7 晚(12%)   —
#     00:00            52        5 晚 (9%)   +1h
#     23:00            54        3 晚 (5%)   +2h
#     22:00            57        0 晚 (0%)   +3h   ← 建議值
#     21:00 / 20:00    57        0 晚 (0%)   +4h / +5h（沒有額外好處）
#
# 22:00 是轉折點：再往前不會多涵蓋任何一晚，只是多錄。
SLEEP_START=22:00:00
SLEEP_END=08:00:00

# Motion Thresholds
MOTION_LARGE=350000
MOTION_MICRO=250000
MIN_MOTION_AREA=50000

# Audio Settings
AUDIO_SILENCE=30
AUDIO_SNOOZE=40

# Video Recording
VIDEO_MIN_DURATION=5
VIDEO_EXTEND_DURATION=5
VIDEO_MAX_DURATION=30
VIDEO_EXTEND_COOLDOWN=10

# Platform-specific FFmpeg (uncomment for your OS)
# Windows:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# macOS:
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# Linux:
# FFMPEG_PATH=/usr/bin/ffmpeg

# Video Codec (uncomment for your OS)
# Windows: VIDEO_CODEC=mp4v
# macOS/Linux: VIDEO_CODEC=avc1

# Headless mode (for servers without display)
# HEADLESS_MODE=true
